          "type": "object",
          "properties": {
            "periodo": {
              "type": "string",
              "enum": [
                "hoje",
                "ontem",
                "semana",
                "mes",
                "mes_passado",
                "personalizado"
              ],
              "description": "Período das vendas."
            },
            "de": {
              "description": "Data inicial YYYY-MM-DD (só para periodo=personalizado).",
