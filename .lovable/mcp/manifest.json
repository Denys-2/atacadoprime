                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ate": {
              "description": "Data final YYYY-MM-DD (só para periodo=personalizado).",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
